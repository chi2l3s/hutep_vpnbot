# Настройки бота
BOT_TOKEN=your_telegram_bot_token_here

# X-UI панель
XUI_API_URL=http://your_vps_ip:20561
XUI_API_KEY=your_xui_api_key_here
XUI_USE_TLS=false

# База данных
DATABASE_URL=sqlite+aiosqlite:///./data/hutep_vpn.db

# NOWPayments
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_WEBHOOK_SECRET=your_webhook_secret_here
NOWPAYMENTS_SANDBOX=false

# Реферальная система
REFERRAL_BONUS_DAYS=7

# Администраторы (через запятую)
ADMIN_IDS=123456789

# Веб-сервер для webhook
WEBHOOK_HOST=https://your_domain.com
WEBHOOK_PATH=/webhook
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080